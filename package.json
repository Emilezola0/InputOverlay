{
  "name": "inputmemory",
  "version": "1.6.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.js"
  },
  "author": "Emilezola0",
  "license": "ISC",
  "description": "Visualiseur, enregistreur et overlay d'inputs clavier / souris / manette",
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "InputMemory",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emilezola0/InputOverlay.git"
  },
  "build": {
    "appId": "com.emilezola0.inputmemory",
    "productName": "InputMemory",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/uiohook-napi/prebuilds/{darwin-*,linux-*,win32-arm64}/**"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "InputMemory-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "InputMemory-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Emilezola0",
        "repo": "InputOverlay"
      }
    ]
  }
}
